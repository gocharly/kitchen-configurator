# Токен бота из @BotFather
TELEGRAM_BOT_TOKEN=
# Telegram id менеджеров через запятую (узнать можно у @userinfobot)
ADMIN_IDS=
# Адрес сайта, на который ведёт ссылка на корзину. Для кнопки-ссылки в Telegram нужен https
PUBLIC_URL=http://localhost:5180
PORT=8787
DATABASE_PATH=server/data/orders.sqlite
# 1, если сервер стоит за прокси, который передаёт X-Forwarded-For
TRUST_PROXY=0
